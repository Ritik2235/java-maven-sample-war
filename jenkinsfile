pipeline {
    agent any

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-21-amazon-corretto.x86_64'
        M2_HOME = '/opt/Maven'
        M2 = '/opt/Maven/bin'
        PATH = "${JAVA_HOME}/bin:${M2}:${env.PATH}"
    }

    stages }
        stage('Build WAR') {
            steps {
                sh '''
                    mvn clean package
                '''
            }
        }
    }
}
